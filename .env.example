# Copied to .env by scripts/gen-env.sh. Supabase keys are filled from `npx supabase status -o env`.
SUPABASE_URL=http://supabase_kong_jaeng:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres:postgres@supabase_db_jaeng:5432/postgres
# password of every demo account; scripts/gen-env.sh fills it with a random one and keeps it afterwards
DEMO_PASSWORD=
DEV_QUICK_LOGIN=true
RATE_LIMIT_REPORTS_PER_DAY=5
RATE_LIMIT_COMMENTS_PER_DAY=30
RATE_LIMIT_PHOTOS_PER_DAY=40
RATE_LIMIT_FIX_CLAIMS_PER_DAY=10
RATE_LIMIT_FLAGS_PER_DAY=20
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# GET /places asks OpenStreetMap Nominatim after the local districts (1 request/s, cached 24 h)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=https://github.com/BKungBK/Jaeng
