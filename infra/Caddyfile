{
	admin off
}

# The Android app (plan 7) runs at http://localhost and calls this server across origins, so /api
# answers CORS for that one origin. /sb is Kong's: it already answers on its own, and a second
# Access-Control-Allow-Origin would make the browser refuse the response (scripts/check-api.mjs checks).
(app_cors) {
	@app_origin header Origin http://localhost
	@app_preflight {
		method OPTIONS
		header Origin http://localhost
	}
	header @app_origin {
		Access-Control-Allow-Origin http://localhost
		+Vary Origin
	}
	header @app_preflight {
		Access-Control-Allow-Methods "GET, POST, PATCH, OPTIONS"
		Access-Control-Allow-Headers "authorization, content-type"
		Access-Control-Max-Age 86400
	}
	respond @app_preflight 204
}

# Single origin for the whole app (spec 4.1). Prefixes are stripped before proxying.
:8000 {
	handle_path /api/* {
		import app_cors
		reverse_proxy api:3000
	}

	handle_path /sb/* {
		reverse_proxy supabase_kong_jaeng:8000
	}

	handle {
		reverse_proxy web:4200
	}
}

# The installable production build (plan 6): apps/web/www from scripts/build-web.sh, with the
# service worker. Same /api and /sb as the dev site; the worker and index.html are never cached.
:8100 {
	handle_path /api/* {
		import app_cors
		reverse_proxy api:3000
	}

	handle_path /sb/* {
		reverse_proxy supabase_kong_jaeng:8000
	}

	handle {
		root * /srv/www
		# Everything but the content-hashed bundles (main-*, chunk-*, polyfills-*, styles-*, scripts-*) is
		# revalidated: the service worker, ngsw.json, index.html and, because try_files turns a deep link
		# such as /r/<id> into index.html, every path that is not a file. (`header` sees the path as asked.)
		@revalidate not path_regexp hashed ^/(main|chunk|polyfills|styles|scripts)-[A-Za-z0-9_-]+\.(js|css)$
		header @revalidate Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
